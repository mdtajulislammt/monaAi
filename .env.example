# ==============================================================================
# Desktop AI Agent (monaAi) Configuration
# ==============================================================================

# Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default LLM Model (e.g. gemini-2.5-pro, gemini-2.5-flash, gemini-1.5-pro)
DEFAULT_MODEL=gemini-2.5-pro

# Safety Settings (STRICT, MODERATE, PERMISSIVE)
SAFETY_MODE=STRICT

# Execution Limits
COMMAND_TIMEOUT_SECONDS=60
MAX_TOOL_ITERATIONS=15

# Default Workspace / Working Directory (Defaults to current directory if blank)
WORKSPACE_ROOT=

# Browser Automation Settings
BROWSER_HEADLESS=false

# Voice Settings
VOICE_RATE=180
VOICE_VOLUME=1.0
VOICE_LANGUAGE=en
