{
  "forbidden_commands": [
    "rm -rf /",
    "rm -rf /*",
    "rm -rf ~",
    "rm -rf $HOME",
    ":(){ :|:& };:",
    "mkfs",
    "mkfs.ext4",
    "mkfs.ext3",
    "mkfs.vfat",
    "mkfs.ntfs",
    "format c:",
    "format d:",
    "dd if=",
    "> /dev/sda",
    "> /dev/nvme",
    "chmod -R 777 /",
    "chown -R root /",
    "shutdown",
    "reboot",
    "init 0",
    "poweroff",
    "halt",
    "drop database",
    "drop table",
    "truncate table",
    "del /f /s /q c:\\",
    "rd /s /q c:\\"
  ],
  "forbidden_patterns": [
    "^rm\\s+-[a-zA-Z]*r[a-zA-Z]*f[a-zA-Z]*\\s+([/~]|\\$HOME|\\.\\.)",
    "^rm\\s+-[a-zA-Z]*f[a-zA-Z]*r[a-zA-Z]*\\s+([/~]|\\$HOME|\\.\\.)",
    ">(?:>)?\\s*/dev/(?:sd[a-z]|nvme[0-9]n[0-9]|hd[a-z])",
    "\\bdd\\s+.*?of=/dev/",
    "(?:drop|truncate)\\s+database\\b",
    "\\bformat\\s+[a-zA-Z]:",
    ":\\(\\)\\s*\\{\\s*:\\|:&\\s*\\};\\s*:",
    "chmod\\s+-R\\s+777\\s+/",
    "chown\\s+-R\\s+.*?\\s+/"
  ],
  "protected_paths": [
    "/",
    "/bin",
    "/boot",
    "/dev",
    "/etc",
    "/lib",
    "/lib64",
    "/proc",
    "/root",
    "/run",
    "/sbin",
    "/sys",
    "/usr",
    "/var/log",
    "C:\\Windows",
    "C:\\Program Files",
    "C:\\Program Files (x86)",
    "C:\\ProgramData",
    "C:\\Users\\Default"
  ],
  "require_confirmation": [
    "git reset --hard",
    "git clean -f",
    "docker system prune",
    "docker rm -f",
    "kill -9",
    "pkill -9",
    "pip uninstall",
    "npm uninstall"
  ]
}
