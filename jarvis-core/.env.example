# ==============================================================================
# JARVIS - Local Autonomous AI Desktop Assistant & System Controller
# ==============================================================================

# Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default LLM Model (e.g. gemini-2.5-flash, gemini-2.5-pro, gemini-3.5-flash-lite)
DEFAULT_MODEL=gemini-2.5-flash

# Safety & Execution Rules
SAFETY_MODE=STRICT
COMMAND_TIMEOUT_SECONDS=60
MAX_TOOL_ITERATIONS=15

# Persistent Memory & Workspace
WORKSPACE_ROOT=
CHROMA_PERSIST_DIR=./data/chroma_db

# Bengali Voice Settings (edge-tts & speech_recognition)
VOICE_LOCALE=bn-BD
VOICE_NAME=bn-BD-PradeepNeural
VOICE_RATE=+0%
VOICE_VOLUME=+0%

# Browser Research (Headless Playwright)
BROWSER_HEADLESS=true
